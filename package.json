{
  "name": "takenbeheer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CLB Takenbeheer — single-user desktop task manager for CLB counsellors (Tauri v2 + React).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",

    "@tanstack/react-table": "^8.20.5",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-notification": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.5",
    "@types/react-big-calendar": "^1.16.3",
    "date-fns": "^4.1.0",
    "react": "^18.3.1",
    "react-big-calendar": "^1.20.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
